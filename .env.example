# Copy to .env and adjust. XAMPP's default root has an empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rsci_sql

# Only used by `npm run setup-db` to create the database, the DB users and the grants.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# Password given to the per-role DB users (rsci_boss, rsci_accountant, ...).
DB_ROLE_PASSWORD=Rsci#Demo2026

# Secret for AES_ENCRYPT / AES_DECRYPT of sensitive columns. Never commit the real one.
ENC_KEY=change-this-long-random-string

# Secret for signing login tokens.
JWT_SECRET=change-this-too

PORT=3000
